{
  "name": "MuteDeck",
  "uuid": "com.mutedeck.flexbar",
  "version": "0.9.0",
  "author": "MuteDeck",
  "entry": "backend/plugin.cjs",
  "description": "Control Zoom, Teams, Google Meet and more from your Flexbar: mute, video, share, record, leave, reactions and custom actions.",
  "repo": "https://github.com/mutedeck/flexbar-plugin",
  "sdk": {
    "version": "1.0.0"
  },
  "software": {
    "minimumVersion": "1.0.0"
  },
  "os": [
    {
      "platform": "mac",
      "minimumVersion": "10.15"
    },
    {
      "platform": "windows",
      "minimumVersion": "10"
    }
  ],
  "device": [
    {
      "name": "flexbar",
      "version": "1.0.0"
    }
  ],
  "configPage": "config",
  "keyLibrary": {
    "title": "$PluginName",
    "style": {
      "icon": "data:image/png;base64,"
    },
    "children": [
      {
        "title": "$Mute.Title",
        "tip": "$Mute.Tip",
        "cid": "com.mutedeck.flexbar.togglemute",
        "config": {
          "keyType": "multiState",
          "platform": [
            "windows",
            "mac"
          ]
        },
        "style": {
          "icon": "mdi mdi-microphone",
          "width": 140,
          "multiStyle": [
            {
              "icon": "mdi mdi-microphone",
              "bgColor": "#2E7D32"
            },
            {
              "icon": "mdi mdi-microphone-off",
              "bgColor": "#C62828"
            },
            {
              "icon": "mdi mdi-microphone-off",
              "bgColor": "#424242",
              "fgColor": "#9E9E9E"
            }
          ]
        },
        "data": {
          "action_type": "toggle"
        }
      },
      {
        "title": "$Video.Title",
        "tip": "$Video.Tip",
