{
  "name": "mutedeck-flexbar-plugin",
  "version": "0.9.0",
  "private": true,
  "description": "MuteDeck plugin for Flexbar (FlexDesigner)",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/patch-flexcli.mjs",
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "manifest": "node scripts/generate-manifest.mjs",
    "typecheck": "tsc --noEmit",
    "sim": "node ../flexbar-simulator/bin/flexbar-sim.js com.mutedeck.flexbar.plugin",
    "dev": "npm-run-all plugin:unlink plugin:link -p plugin:watch plugin:debug",
    "plugin:watch": "rollup -c -w --watch.onEnd=\"npm run plugin:restart\"",
    "plugin:unlink": "flexcli plugin unlink --uuid com.mutedeck.flexbar --silent",
    "plugin:link": "flexcli plugin link --path com.mutedeck.flexbar.plugin --uuid com.mutedeck.flexbar --start false",
    "plugin:restart": "flexcli plugin restart --uuid=com.mutedeck.flexbar",
    "plugin:debug": "flexcli plugin debug --uuid=com.mutedeck.flexbar",
    "plugin:validate": "flexcli plugin validate --path com.mutedeck.flexbar.plugin",
    "plugin:pack": "flexcli plugin pack --path com.mutedeck.flexbar.plugin",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@eniac/flexdesigner": "^1.0.9",
    "@mutedeck/plugin-client": "^1.0.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eniac/flexcli": "^1.0.7",
    "@rollup/plugin-commonjs": "^28.0.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.2.2",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.0",
    "@types/node": "^20.15.0",
    "@types/ws": "^8.18.1",
    "npm-run-all": "^4.1.5",
    "rollup": "^4.0.2",
    "tslib": "^2.6.2",
    "typescript": "^5.2.2"
  }
}
